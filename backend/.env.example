DATABASE_URL=mysql+pymysql://email_sender:change-me@host.docker.internal:3306/email_sender
# Production deployment auto-detects this for an existing MySQL container.
# Leave blank for local setup or an explicitly external database URL.
DATABASE_HOST_OVERRIDE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable Gmail API and add gmail.modify plus openid/email/profile in Google Auth
# Platform > Data Access. New logins request all existing Gmail features.
# Exact scopes and feature endpoints: docs/google-cloud-setup.md.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
GROQ_API_KEY=
# Generate independent secrets using the commands in README.md.
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379/0
SYNC_MAX_ATTEMPTS=4
SYNC_INTERVAL_SECONDS=300
SYNC_RECONCILE_SECONDS=86400
SYNC_TASK_TIME_LIMIT=1800
SYNC_REQUESTS_PER_SECOND=10
# Optional Gmail push. Leave all blank until the Google Cloud topic and authenticated
# push subscription exist. The endpoint URL is /api/v1/webhooks/gmail/pubsub.
GMAIL_PUSH_TOPIC=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
PUBSUB_SUBSCRIPTION=

# Automatic incoming-mail classification for Mybox using the configured Groq key.
# Sender, subject, and up to 6000 text characters are shared with Groq.
MYBOX_ENABLED=true
MYBOX_MODEL=openai/gpt-oss-120b
